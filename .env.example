# Public production origin used for canonical URLs, sitemap, robots.txt, and social cards.
NEXT_PUBLIC_SITE_URL=https://www.goldenhourdelhi.co.in

# Optional Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
# Leave blank to keep analytics disabled. Never place private API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_GA_ID=

# Set true when the hosting proxy is configured to terminate TLS and forward HTTP.
ENABLE_HTTPS_REDIRECT=false
